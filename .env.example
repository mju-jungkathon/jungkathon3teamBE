# PostgreSQL
POSTGRES_DB=aftergrow
POSTGRES_USER=dev
POSTGRES_PASSWORD=change-me

# Redis
REDIS_HOST=localhost   # 로컬 개발용. 배포는 docker-compose.prod.yml이 redis 컨테이너명을 직접 주입합니다
REDIS_PORT=6379

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=2592000000

# OpenAI (AI 회복 가이드)
# 비워두면 규칙 기반 가이드로 폴백합니다. model/timeout-ms는 application.yml에 기본값이 있어 선택입니다.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=8000

# 기상청 생활기상지수 (시간대별 UV 예보)
# 공공데이터포털에서 발급받은 서비스키. 비워두면 UV 예보가 모의값으로 응답합니다.
# 인코딩/디코딩 두 벌을 주는데 둘 다 그대로 전달됩니다 — 한쪽이 인증 실패하면 다른 쪽을 넣어보세요.
# 참고: 로컬 실행(gradlew bootRun)은 .env를 읽지 않습니다. application-local.yml의 kma.service-key에 넣으세요.
KMA_SERVICE_KEY=

# Spring 프로파일
SPRING_PROFILES_ACTIVE=local
